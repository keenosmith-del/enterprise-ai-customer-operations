{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "LLM_PROVIDER=demo MESSAGING_PROVIDER=rabbitmq vitest run src/tests/unit.test.ts src/tests/adapters.test.ts",
    "test:integration": "LLM_PROVIDER=demo MESSAGING_PROVIDER=rabbitmq RABBITMQ_QUEUE_PREFIX=operations-test vitest run src/tests/integration.test.ts --testTimeout=60000",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js"
  },
  "dependencies": {
    "@azure/service-bus": "^7.9.5",
    "@prisma/client": "6.12.0",
    "amqplib": "^0.10.9",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "prisma": "6.12.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3"
  }
}
