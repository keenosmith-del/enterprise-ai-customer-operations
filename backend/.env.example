NODE_ENV=development
PORT=5050
DATABASE_URL=postgresql://operations:operations_local@localhost:5432/operations
RABBITMQ_URL=amqp://operations:operations_local@localhost:5672
RABBITMQ_QUEUE_PREFIX=operations
MESSAGING_PROVIDER=rabbitmq
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE=operations
LLM_PROVIDER=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=30000
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
CORS_ORIGIN=http://localhost:5173
# Required for administrative changes; replace this local example before any deployment.
ADMIN_TOKEN=local-operator-change-me
QUALITY_GATE_ACCURACY=0.8
QUALITY_GATE_SCHEMA=0.95
MAX_ATTEMPTS=3
RETRY_BASE_MS=2000
