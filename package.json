{
  "name": "enterprise-ai-customer-operations",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint backend/src backend/prisma frontend/src",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "format": "prettier --write backend/src backend/prisma/seed.ts frontend/src docs README.md"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "@eslint/js": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  },
  "type": "module"
}
